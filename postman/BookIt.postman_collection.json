{
  "info": {
    "_postman_id": "3f4ed3cf-1d78-4e4f-8a7d-3f93d7a1a9f5",
    "name": "BookIt API",
    "description": "Коллекция для проверки API BookIt",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "futureDate", "value": "" },
    { "key": "pastDate", "value": "" },
    { "key": "serviceId", "value": "1" },
    { "key": "bookingId", "value": "1" },
    { "key": "slotId", "value": "1" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function formatDate(date) {",
          "  const year = date.getFullYear();",
          "  const month = String(date.getMonth() + 1).padStart(2, '0');",
          "  const day = String(date.getDate()).padStart(2, '0');",
          "  return `${year}-${month}-${day}`;",
          "}",
          "const future = new Date();",
          "future.setDate(future.getDate() + 1);",
          "while (future.getDay() === 0) {",
          "  future.setDate(future.getDate() + 1);",
          "}",
          "const past = new Date();",
          "past.setDate(past.getDate() - 1);",
          "pm.collectionVariables.set('futureDate', formatDate(future));",
          "pm.collectionVariables.set('pastDate', formatDate(past));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('token', body.token); }",
                  "if (body.user && body.user.id) { pm.collectionVariables.set('currentUserId', body.user.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_user\",\n  \"password\": \"pass1234\",\n  \"timezone\": \"Europe/Moscow\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('token', body.token); }",
                  "if (body.user && body.user.id) { pm.collectionVariables.set('currentUserId', body.user.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo\",\n  \"password\": \"user123\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/logout"
          }
        }
      ]
    },
    {
      "name": "Public API",
      "item": [
        {
          "name": "Services list",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/services?search=&sort=price_asc"
          }
        },
        {
          "name": "Service details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/services/{{serviceId}}"
          }
        },
        {
          "name": "Available slots",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/available-slots?service_id={{serviceId}}&date={{futureDate}}"
          }
        },
        {
          "name": "Busy times",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bookings/busy-times?service_id={{serviceId}}&date={{futureDate}}"
          }
        }
      ]
    },
    {
      "name": "Protected API",
      "auth": {
        "type": "bearer",
        "bearer": [
          { "key": "token", "value": "{{token}}", "type": "string" }
        ]
      },
      "item": [
